# Normalize text files automatically
* text=auto

# Rust source files — always LF
*.rs text eol=lf

# Cargo manifests and lockfile — always LF
Cargo.toml text eol=lf
Cargo.lock text eol=lf

# Bundled SKILL.md files are parsed by serde_yaml at compile time via
# include_str!. CRLF can break YAML frontmatter parsing.
# Keep all bundled skills on LF across platforms.
src/alphacode_base/bundled_skills/**/SKILL.md text eol=lf

# Other configuration and structured data files — always LF
*.toml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Documentation and text files — always LF
*.md text eol=lf
*.mdx text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.adoc text eol=lf

# Web assets and frontend source — always LF
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Shell scripts and Unix build files — always LF
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows command scripts — always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts — preserve LF for consistent source control
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# Treat common binary assets as binary — never normalize
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.bin binary
*.dat binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.wasm binary