# Force Cargo.lock to always use LF so `cargo --locked` passes on all platforms.
Cargo.lock text eol=lf

# Bundled SKILL.md files are parsed by serde_yaml at compile time via
# include_str!. CRLF line endings break YAML frontmatter parsing
# ("mapping values are not allowed in this context"), so force LF to
# prevent CRLF re-introduction on Windows checkouts.
src/alphacode_base/bundled_skills/**/SKILL.md text eol=lf
